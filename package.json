{
  "name": "reference-for-zotero",
  "version": "1.0.1",
  "description": "References and citing papers in the Zotero 9 Reader.",
  "config": {
    "addonName": "Reference for Zotero",
    "addonID": "referenceforzotero@woif-sha.github.io",
    "addonRef": "referenceforzotero",
    "addonInstance": "ReferenceForZotero"
  },
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "start": "zotero-plugin serve",
    "test": "node --test --test-concurrency=1 --test-timeout=60000 --import tsx test/**/*.test.ts",
    "test:scansci-python": "python -B -m unittest discover -s test/python -p \"test_*.py\" -v",
    "test:scansci-smoke": "tsx test/scansci/local-legal-smoke.ts",
    "audit:scansci-xpi": "python -B test/python/audit_scansci_xpi.py",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && zotero-plugin build",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"typings/**/*.d.ts\" \"addon/**/*.{js,json,md}\" eslint.config.js README.md CHANGELOG.md CONTRIBUTING.md PRIVACY.md SECURITY.md package.json tsconfig.json zotero-plugin.config.ts",
    "lint": "eslint src test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Woif-sha/reference-for-zotro.git"
  },
  "author": "Woif-sha and contributors",
  "license": "AGPL-3.0-or-later",
  "homepage": "https://github.com/Woif-sha/reference-for-zotro",
  "dependencies": {
    "entities": "^6.0.1",
    "zotero-plugin-toolkit": "^5.1.0-beta.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.16.5",
    "eslint": "^10.8.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.7.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "zotero-plugin-scaffold": "^0.8.2",
    "zotero-types": "^4.1.0-beta.3"
  }
}
