{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node", "zotero-types"]
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "typings/**/*.d.ts",
    "zotero-plugin.config.ts"
  ]
}
